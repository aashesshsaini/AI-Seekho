# Copy to .env.local for local development. NEVER commit real values.
# On Netlify: Site configuration → Environment variables.

# Public base URL (no trailing slash). Change when you add a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random secret (32+ chars) for signed download links + token encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# MongoDB Atlas (or local: mongodb://127.0.0.1:27027 via `npm run dev:db`)
MONGODB_URI=
MONGODB_DB=aiseekho

# Razorpay — start with TEST keys (rzp_test_…). Live keys only after explicit approval.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Private product storage: "local" (dev, uses PRIVATE_ASSETS_DIR) or "netlify-blobs" (production)
STORAGE_DRIVER=local
PRIVATE_ASSETS_DIR=.private-assets
BLOBS_STORE=product-files
# Optional; must match the region used when uploading. Leave empty for the default.
BLOBS_REGION=
# Only needed to run `npm run assets:upload` against Netlify Blobs from your Mac:
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Email (optional). Leave EMAIL_PROVIDER empty to keep email delivery disabled.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# Analytics (optional, consent-gated). Leave empty to disable all tracking.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile (optional extra spam protection on forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private staging gate (HTTP Basic Auth + noindex). Set both to enable; password min 12 chars.
# Leave EMPTY in production. Requires a redeploy to change.
STAGING_GATE_USER=
STAGING_GATE_PASSWORD=
