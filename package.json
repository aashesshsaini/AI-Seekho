{
  "name": "ai-seekho-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "assets:upload": "tsx --env-file-if-exists=.env.local scripts/upload-assets.ts",
    "check:safety": "bash scripts/check-repo-safety.sh",
    "staging:init-env": "bash scripts/init-staging-env.sh",
    "staging:seed": "tsx --env-file=.env.staging.local scripts/seed.ts",
    "staging:admin": "tsx --env-file=.env.staging.local scripts/create-admin.ts",
    "staging:upload": "tsx --env-file=.env.staging.local scripts/upload-assets.ts --dir ~/Downloads",
    "staging:check-db": "tsx --env-file=.env.staging.local scripts/check-db.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "mongoose": "^9.12.0",
    "motion": "^14.10.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
